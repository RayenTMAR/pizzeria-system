DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
# Leave empty in development: distance/time are mocked.
GOOGLE_MAPS_API_KEY=""
MOCK_KM=4
MOCK_MINUTES=12
# Used only by the seed script
SEED_JEFE_PASSWORD="replace-with-jefe-password"
# Push notifications: Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the whole JSON on one line. Leave empty to disable push (it is only logged).
FIREBASE_SERVICE_ACCOUNT_JSON=""
